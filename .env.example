# ─── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
APP_PORT=3333
# Origens do front liberadas no CORS (separadas por vírgula)
CORS_ORIGIN=http://localhost:3000
# Nº de proxies à frente da API em produção (Render/Railway = 1); 0 = acesso direto
TRUST_PROXY=0

# ─── Banco (PostgreSQL) ───────────────────────────────────────────────────────
# Em produção (Neon, Supabase, RDS...) acrescente ?sslmode=require se o provedor exigir
DATABASE_URL=postgres://postgres:postgres@localhost:5432/liriou
DATABASE_POOL_MAX=10
# true = roda as migrations pendentes ao subir a API (útil em deploy)
DATABASE_MIGRATIONS_RUN=false
DATABASE_LOGGING=false

# ─── Auth (dashboard) ─────────────────────────────────────────────────────────
# gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h

# ─── Seed (npm run seed) ──────────────────────────────────────────────────────
# Cria o primeiro admin do dashboard se ainda não existir
ADMIN_NAME=Equipe Líriou
ADMIN_EMAIL=admin@liriou.com.br
ADMIN_PASSWORD=

# Mercado Pago (Checkout Transparente / Orders API)
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# Frenet (frete, etiquetas e rastreio)
FRENET_TOKEN=
FRENET_PARTNER_TOKEN=
FRENET_SELLER_CEP=
FRENET_WEBHOOK_KEY=
PUBLIC_API_URL=
